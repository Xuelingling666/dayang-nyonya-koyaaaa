# Contoh konfigurasi dasar Lavalink v4. Simpan sebagai application.yml di server Lavalink.
server:
  port: 2333
  address: 0.0.0.0
lavalink:
  server:
    password: "GANTI_PASSWORD_PANJANG_DAN_UNIK"
    sources:
      youtube: false
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      nico: false
      http: true
      local: false
    filters:
      volume: true
      equalizer: true
      karaoke: true
      timescale: true
      tremolo: true
      vibrato: true
      rotation: true
      distortion: true
      channelMix: true
      lowPass: true
    youtubeConfig:
      email: ""
      password: ""
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
logging:
  level:
    root: INFO
    lavalink: INFO
